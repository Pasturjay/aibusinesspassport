# ==============================================================================
# AI Business Passport - Environment Variables Template
# ==============================================================================

# Core Application URLs
APP_BASE_URL=http://localhost:3000
PASSPORT_PUBLIC_BASE_URL=http://localhost:3000/p

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Convex Database & Business Brain
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
CONVEX_DEPLOYMENT=dev:placeholder

# Sentry Monitoring & Error Tracking
SENTRY_DSN=https://placeholder@sentry.io/placeholder
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@sentry.io/placeholder
SENTRY_AUTH_TOKEN=sntrys_placeholder
SENTRY_ORG=placeholder-org
SENTRY_PROJECT=placeholder-project

# Analytics - PostHog (Product Analytics across App & Web)
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_API_KEY=phx_placeholder

# Analytics - Google Analytics 4 (Marketing Landing Site ONLY)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Customer Support - Crisp Chat
NEXT_PUBLIC_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Payments - Paystack (Primary)
PAYSTACK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=placeholder_secret

# Payments - Nomba (Secondary / Backup)
NOMBA_CLIENT_ID=placeholder_client_id
NOMBA_CLIENT_SECRET=placeholder_client_secret
NOMBA_ACCOUNT_ID=placeholder_account_id

# Email Delivery - Brevo
BREVO_API_KEY=xkeysib-placeholder

# Revenue Metrics - ChartMogul
CHARTMOGUL_API_KEY=placeholder_chartmogul_key

# Background Processing & Orchestration - Inngest
INNGEST_EVENT_KEY=placeholder_event_key
INNGEST_SIGNING_KEY=placeholder_signing_key

# LLM Providers & Models (/lib/llm)
# Provider must be 'claude' or 'gemini'
LLM_PROVIDER=gemini
LLM_MODEL_FAST=gemini-1.5-flash
LLM_MODEL_STRONG=gemini-1.5-pro
ANTHROPIC_API_KEY=sk-ant-placeholder
GEMINI_API_KEY=AIzaSyPlaceholder

# Cloudflare R2 Storage (Object Bytes)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=ai-business-passport-docs

# Public Passport Resolver & Worker Security
PASSPORT_RESOLVER_SECRET=placeholder_resolver_secret

# SMS & WhatsApp Notifications
TERMII_API_KEY=placeholder_termii_key
WHATSAPP_PROVIDER_KEY=placeholder_whatsapp_key
